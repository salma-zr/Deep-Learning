# Results (regenerate from experiments)
# Keep structure but ignore contents
results/preds/*.jsonl
results/scores/*.csv
results/qualitative/*.html
results/figures/*.png
results/report_assets/*.tex

# Report build artifacts
report/*.aux
report/*.log
report/*.out
report/*.toc
report/*.bbl
report/*.blg
report/*.synctex.gz
report/*.fdb_latexmk
report/*.fls

# But keep the template and generated tables
!report/report.tex
!report/tables/
!report/figures/
!results/report_assets/

